# ==========================================
# DROPSCOOP BACKEND ENVIRONMENT VARIABLES
# ==========================================

PORT=5000

# 1. LOCAL DEVELOPMENT FRONTEND URL
# Use this when running the frontend on your local machine
FRONTEND_URL=http://localhost:5173

# 2. PRODUCTION DEPLOYMENT FRONTEND URL (Netlify)
# Swap to this when you deploy the frontend to Netlify
# FRONTEND_URL=https://your-dropscoop-frontend.netlify.app

# --- MONGODB CONNECTION ---
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dropscoop?retryWrites=true&w=majority

# --- CLERK (Backend Auth Verification) ---
CLERK_SECRET_KEY=sk_test_...

# --- IMAGEKIT (Image Uploads) ---
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/...

# --- STRIPE (Payments) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- NODEMAILER (Gmail) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# --- GEMINI AI ---
GEMINI_API_KEY=AIza...
